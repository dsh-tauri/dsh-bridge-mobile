{
  "name": "dsh-bridge-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsh-tauri/dsh-bridge-mobile.git"
  },
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25 || >=26"
  },
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:shuffle": "vitest run --sequence.shuffle",
    "build": "expo export --platform android",
    "prebuild:android": "expo prebuild --platform android --no-install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "heroui-native": "1.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-if-lite": "0.1.0",
    "react-native": "0.86.3",
    "react-native-drawer-layout": "4.2.11",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-lucide": "npm:lucide-react-native@1.50.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uniwind": "1.12.1",
    "valtio": "2.3.2",
    "valtio-define": "1.4.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@eslint-react/eslint-plugin": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "5.0.3"
  }
}
